{
  "name": "ericmann/these-things-matter",
  "description": "These Things Matter — ttm-core plugin and ttm-theme block theme for eric.mann.blog",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "yoast/phpunit-polyfills": "^4.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "automattic/vipwpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.7",
    "php-stubs/wp-cli-stubs": "^2.11"
  },
  "autoload": {
    "psr-4": { "TTM\\Core\\": "plugins/ttm-core/src/" }
  },
  "autoload-dev": {
    "psr-4": { "TTM\\Tests\\Unit\\": "tests/unit/", "TTM\\Tests\\Integration\\": "tests/integration/" }
  },
  "config": {
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true,
    "platform": { "php": "8.1.0" }
  },
  "scripts": {
    "lint": ["@lint:syntax", "@lint:phpcs"],
    "lint:syntax": "find plugins themes tests -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null",
    "lint:phpcs": "phpcs -q --report=summary --report-full",
    "lint:fix": "phpcbf",
    "test:unit": "phpunit -c phpunit.xml.dist"
  }
}
