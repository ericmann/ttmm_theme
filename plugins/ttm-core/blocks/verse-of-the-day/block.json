{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttm/verse-of-the-day",
	"title": "Verse of the Day",
	"category": "ttm",
	"description": "The current daily meditation verse, with a fallback to the last good verse (F6).",
	"textdomain": "ttm-core",
	"attributes": {
		"compact": {
			"type": "boolean",
			"default": false
		},
		"previewState": {
			"type": "string",
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
