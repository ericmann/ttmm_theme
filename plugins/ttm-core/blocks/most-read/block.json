{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttm/most-read",
	"title": "Most Read",
	"category": "ttm",
	"description": "Manually-flagged \"Most read\" list for the current category archive (01 §4.29, Q6).",
	"textdomain": "ttm-core",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 0
		},
		"source": {
			"type": "string",
			"enum": [ "manual", "views" ],
			"default": "manual",
			"description": "\"views\" is not implemented (Q6: no analytics dependency); treated as \"manual\"."
		},
		"previewState": {
			"type": "string",
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
