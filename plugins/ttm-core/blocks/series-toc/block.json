{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttm/series-toc",
	"title": "Series Table of Contents",
	"category": "ttm",
	"description": "\"In this series\" (01 §4.20) / chapters list (02 §D), F23/F24, F11.",
	"textdomain": "ttm-core",
	"usesContext": [ "postId" ],
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [ "series", "chapters" ],
			"default": "series"
		},
		"seriesId": {
			"type": "number",
			"default": 0
		},
		"limit": {
			"type": "number",
			"default": 0
		},
		"order": {
			"type": "string",
			"enum": [ "asc", "desc" ],
			"default": "asc"
		},
		"showDek": {
			"type": "boolean",
			"default": false
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"previewState": {
			"type": "string",
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
