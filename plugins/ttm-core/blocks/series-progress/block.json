{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttm/series-progress",
	"title": "Series Progress",
	"category": "ttm",
	"description": "Segmented progress bar + meta line (01 §4.19), F23.",
	"textdomain": "ttm-core",
	"usesContext": [ "postId" ],
	"attributes": {
		"seriesId": {
			"type": "number",
			"default": 0
		},
		"previewState": {
			"type": "string",
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
