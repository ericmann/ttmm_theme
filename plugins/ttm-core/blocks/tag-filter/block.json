{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttm/tag-filter",
	"title": "Tag Filter",
	"category": "ttm",
	"description": "Top-tag filter row on a category archive (F16).",
	"textdomain": "ttm-core",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 0
		},
		"previewState": {
			"type": "string",
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
