{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttm/story-tiles",
	"title": "Story Tiles",
	"category": "ttm",
	"description": "Short-fiction tiles (01 §4.35), F19 cover-story image, F20 empty.",
	"textdomain": "ttm-core",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 0
		},
		"columns": {
			"type": "number",
			"default": 0
		},
		"previewState": {
			"type": "string",
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
