{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ttm/category-stats",
	"title": "Category Stats",
	"category": "ttm",
	"description": "Archive header meta: article count, year range, series touch count, RSS link (01 §4.25).",
	"textdomain": "ttm-core",
	"attributes": {
		"previewState": {
			"type": "string",
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"color": false,
		"typography": false,
		"spacing": false
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
