<?xml version="1.0"?>
<ruleset name="These Things Matter">
  <description>WordPress + VIP (cache-aware) + PHPCompatibility for ttm-core and ttm-theme.</description>
  <file>plugins</file>
  <file>themes</file>
  <file>tests</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>
  <arg value="sp"/>
  <arg name="parallel" value="4"/>
  <arg name="cache" value=".phpcs.cache"/>
  <config name="testVersion" value="8.1-"/>
  <config name="minimum_wp_version" value="6.7"/>
  <rule ref="WordPress-Extra">
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
  </rule>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress-VIP-Go"/>
  <rule ref="PHPCompatibilityWP"/>
  <!-- Security sniffs are errors, never warnings (SPEC §3.3 rule 14). -->
  <rule ref="WordPress.Security"><type>error</type></rule>
  <rule ref="WordPress.DB.PreparedSQL"><type>error</type></rule>
  <rule ref="WordPress.WP.AlternativeFunctions"><type>error</type></rule>
  <rule ref="WordPress.PHP.DevelopmentFunctions"><type>error</type></rule>
  <rule ref="WordPress.PHP.DiscouragedPHPFunctions"><type>error</type></rule>
  <!-- Warnings never fail the run; security/DB sniffs are promoted to errors below. -->
  <config name="ignore_warnings_on_exit" value="1"/>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties><property name="prefixes" type="array"><element value="ttm"/><element value="TTM"/></property></properties>
    <!-- "ttm" is the prefix fixed by the design handoff (docs/README.md). -->
    <exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="ttm-core"/><element value="ttm-theme"/></property></properties>
  </rule>
  <rule ref="WordPress.Files.FileName">
    <properties><property name="strict_class_file_names" value="false"/></properties>
    <exclude-pattern>*/src/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.Files.FileName.InvalidClassFileName"><exclude-pattern>*/src/*</exclude-pattern></rule>
  <!-- Tests may use PHPUnit's style. -->
  <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase"><exclude-pattern>*/tests/*</exclude-pattern><exclude-pattern>*/src/*</exclude-pattern></rule>
  <rule ref="Squiz.Commenting"><exclude-pattern>*/tests/*</exclude-pattern></rule>
  <rule ref="Generic.Commenting"><exclude-pattern>*/tests/*</exclude-pattern></rule>
  <rule ref="WordPress.WP.GlobalVariablesOverride"><exclude-pattern>*/tests/*</exclude-pattern></rule>
</ruleset>
