{
  "verify": [
    "composer lint",
    "composer test:unit",
    "npm run lint",
    "npm run test:unit",
    "npm run build",
    "bash scripts/forbidden-patterns.sh"
  ],
  "extraVerify": {
    "plugins/ttm-core/": ["npm run test:integration"],
    "themes/ttm-theme/": ["npm run test:integration"],
    "tests/integration/": ["npm run test:integration"],
    "themes/ttm-theme/theme.json": ["npm run check:theme-json"],
    "tests/e2e/": ["npm run test:e2e"]
  },
  "build": ["npm run build"],
  "baseBranch": "poc",
  "branchPrefix": "poc/",
  "maxRounds": 3,
  "commandTimeoutMs": 900000
}
